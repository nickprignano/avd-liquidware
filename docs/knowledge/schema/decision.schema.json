{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision.schema.json",
  "title": "Decision record front matter (MADR 4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "date"],
  "properties": {
    "status": {
      "type": "string",
      "pattern": "^(proposed|accepted|rejected|deprecated|superseded by \\d{4})$"
    },
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "decision-makers": {"type": "array", "items": {"type": "string"}},
    "consulted": {"type": "array", "items": {"type": "string"}},
    "informed": {"type": "array", "items": {"type": "string"}},
    "review": {"type": "string", "description": "Why the decision is being reconsidered, if it is."}
  }
}
