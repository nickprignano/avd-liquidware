{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "known-errors.schema.json",
  "title": "Known errors catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["errors"],
  "properties": {
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "symptom", "cause", "fix", "source", "status", "added"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "symptom": {"type": "string", "minLength": 5, "description": "Exact error text where there is one, with names stripped."},
          "cause": {"type": "string", "minLength": 3},
          "fix": {"type": "string", "minLength": 3},
          "source": {"type": "string", "description": "KB path relative to docs/knowledge/, or an https URL."},
          "applies_to": {"type": "string", "description": "Versions the entry was seen on, e.g. anthropic 0.69.0 or Claude Code 2.1.0."},
          "status": {"enum": ["verified", "unverified"]},
          "added": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "issue": {"type": "integer", "description": "The feedback issue the entry came from."}
        }
      }
    }
  }
}
