{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field-reports.schema.json",
  "title": "Field reports",
  "description": "What worked or broke when someone used the KB's advice. Written by the kb-feedback workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reports"],
  "properties": {
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "page", "outcome", "summary", "issue"],
        "properties": {
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "page": {"type": "string", "description": "KB path relative to docs/knowledge/."},
          "outcome": {"enum": ["worked", "broke", "outdated", "missing"]},
          "summary": {"type": "string", "minLength": 5},
          "versions": {"type": "string"},
          "evidence": {"type": "string"},
          "issue": {"type": "integer"},
          "resolved": {"type": "boolean", "description": "Set when the page has been updated for this report."}
        }
      }
    }
  }
}
